# RecipeMate – miljøvariabler
# Kopier til .env.local ved behov. Appen starter uten noen av disse.
# Skriv aldri ekte nøkler i denne fila; .env* (unntatt .env.example) er utelatt fra git.

# API-nøkkel for forslag fra språkmodell (Epic 4). Valgfri: import, skalering og lagring virker uten.
LLM_API_KEY=

# Modellnavn for forslag. Valgfri.
LLM_MODEL=

# Sti til SQLite-databasen. Standard: data/recipemate.db
DATABASE_PATH=

# Hvor oppskriftssider hentes fra ved import: http (standard, nettet) eller fixtures (lagrede
# sider i test/fixtures/, for demo uten nett). Alt annet er http.
IMPORT_SOURCE=
